// RUN: opt -enable-ml-inliner=release -mlgo-model=_test_inc -passes='scc-oz-module-inliner,print<inline-advisor>' \
// RUN:     -keep-inline-advisor-for-printing -max-devirt-iterations=0 \
// RUN:     -mandatory-inlining-first=0 -S < %s 2>&1 | FileCheck %s
// RUN: %if have_mlir_lowering %{ opt -enable-ml-inliner=release -mlgo-model=_test_mlir -passes='scc-oz-module-inliner,print<inline-advisor>' -keep-inline-advisor-for-printing -max-devirt-iterations=0 -mandatory-inlining-first=0 -S < %s 2>&1 | FileCheck %s %}
// RUN: %if llvm_inliner_model_autogenerated %{ opt -enable-ml-inliner=release -passes='scc-oz-module-inliner,print<inline-advisor>' -keep-inline-advisor-for-printing -max-devirt-iterations=0 -mandatory-inlining-first=0 -S < %s 2>&1 | FileCheck %s %}


module attributes {dlti.dl_spec = #dlti.dl_spec<i64 = dense<64> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little", "dlti.mangling_mode" = "e", "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.stack_alignment" = 128 : i64>, llvm.module_asm = [], llvm.target_triple = "x86_64-grtev4-linux-gnu"} {
  llvm.func @caller(%arg0: i32) attributes {no_inline, optimize_none} {
    llvm.call @callee(%arg0) : (i32) -> ()
    llvm.return
  }
  llvm.func @callee(%arg0: i32) attributes {always_inline} {
    %0 = llvm.mlir.constant(0 : i32) : i32
    llvm.br ^bb1
  ^bb1:  // 2 preds: ^bb0, ^bb1
    %1 = llvm.icmp "slt" %arg0, %0 : i32
    llvm.cond_br %1, ^bb1, ^bb2
  ^bb2:  // pred: ^bb1
    llvm.return
  }
}

// CHECK: [MLInlineAdvisor] FPI:
// CHECK: caller:
// CHECK: MaxLoopDepth: 1
