// Test skipping inlining when the callsite is unreachable (for both mandatory
// and non-mandatory cases)
// RUN: mlir-opt --inline='enable-ml-inliner=release mlir-mlgo-model=_test_inc' < %s | FileCheck %s --check-prefix=CHECK
// RUN: %if have_mlir_lowering %{ mlir-opt --inline='enable-ml-inliner=release mlir-mlgo-model=_test_mlir' < %s | FileCheck %s --check-prefix=CHECK %}
// RUN: %if llvm_inliner_model_autogenerated %{ mlir-opt --inline='enable-ml-inliner=release' < %s | FileCheck %s --check-prefix=CHECK %}

module attributes {dlti.dl_spec = #dlti.dl_spec<!llvm.ptr<270> = dense<32> : vector<4xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, i64 = dense<64> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little", "dlti.mangling_mode" = "e", "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.stack_alignment" = 128 : i64>, llvm.module_asm = [], llvm.target_triple = "x86_64-grtev4-linux-gnu"} {
  llvm.func @f1() -> i32 {
    %0 = llvm.mlir.constant(1 : i32) : i32
    llvm.br ^bb1
  ^bb1:  // pred: ^bb0
    llvm.return %0 : i32
  }
  llvm.func @f2() -> i32 attributes {always_inline} {
    %0 = llvm.mlir.constant(2 : i32) : i32
    llvm.return %0 : i32
  }
  llvm.func @f3() -> i32 {
    %0 = llvm.mlir.constant(1 : i32) : i32
    llvm.br ^bb1
  ^bb1:  // pred: ^bb0
    llvm.return %0 : i32
  }
  llvm.func @f4() -> i32 {
    %0 = llvm.mlir.constant(2 : i32) : i32
    llvm.return %0 : i32
  }
}

// CHECK-LABEL: @f1
// was check-label
//  some_bb
// was check-next
//  call i32 @f2
// CHECK-NEXT llvm.func @f2() -> i32
// CHECK-LABEL: @f3
// was check-label
// some_bb
// was check-next
//  call i32 @f4
// CHECK-NEXT llvm.func @f4() -> i32
