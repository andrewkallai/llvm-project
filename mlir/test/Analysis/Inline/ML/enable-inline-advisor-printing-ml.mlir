  llvm.func @_Z3fooi(%arg0: i32 {llvm.noundef}) -> (i32 {llvm.noundef}) attributes {dso_local} {
    llvm.return %arg0 : i32
  }
  llvm.func @main(%arg0: i32 {llvm.noundef}, %arg1: !llvm.ptr {llvm.noundef}) -> (i32 {llvm.noundef}) attributes {dso_local} {
    %0 = llvm.call @_Z3fooi(%arg0) : (i32 {llvm.noundef}) -> (i32 {llvm.noundef})
    llvm.return %0 : i32
  }
}

