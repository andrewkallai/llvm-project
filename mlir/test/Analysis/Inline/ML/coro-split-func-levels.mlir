// RUN: mlir-opt  --inline='print-inline-advisor=true enable-ml-inliner=release mlir-mlgo-model=_test_inc' \
// RUN:  -keep-inline-advisor-for-printing < %s 2>&1 | FileCheck %s
// RUN: %if have_mlir_lowering %{ mlir-opt  --inline='print-inline-advisor=true enable-ml-inliner=release mlir-mlgo-model=_test_mlir' -keep-inline-advisor-for-printing < %s 2>&1 | FileCheck %s %}
// RUN: %if llvm_inliner_model_autogenerated %{ mlir-opt  --inline='print-inline-advisor=true enable-ml-inliner=release' -keep-inline-advisor-for-printing < %s 2>&1 | FileCheck %s %}

module attributes {dlti.dl_spec = #dlti.dl_spec<!llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, i64 = dense<[32, 64]> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little">, llvm.module_asm = [], llvm.target_triple = ""} {
  llvm.func @_Z5get_sv() attributes {passthrough = ["presplitcoroutine"]} {
    %0 = llvm.mlir.constant(0 : i32) : i32
    %1 = llvm.mlir.zero : !llvm.ptr
    %2 = llvm.mlir.none : token
    %3 = llvm.mlir.constant(false) : i1
    %4 = llvm.intr.coro.id %0, %1, %1, %1 : (i32, !llvm.ptr, !llvm.ptr, !llvm.ptr) -> token
    %5 = llvm.intr.coro.begin %4, %1 : (token, !llvm.ptr) -> !llvm.ptr
    %6 = llvm.intr.coro.save %1 : (!llvm.ptr) -> token
    %7 = llvm.intr.coro.suspend %2, %3 : i8
    llvm.call @_ZN1S12promise_typeD2Ev() : () -> ()
    llvm.return
  }
  llvm.func @__clang_call_terminate()
  llvm.func @__gxx_personality_v0(...) -> i32
  llvm.func @_ZN1S12promise_typeD2Ev() attributes {personality = @__gxx_personality_v0} {
    %0 = llvm.mlir.zero : !llvm.ptr
    llvm.invoke @_Z4funcv() to ^bb1 unwind ^bb2 : () -> ()
  ^bb1:  // pred: ^bb0
    llvm.return
  ^bb2:  // pred: ^bb0
    %1 = llvm.landingpad (catch %0 : !llvm.ptr) : !llvm.struct<(ptr, i32)>
    llvm.call @__clang_call_terminate() : () -> ()
    llvm.unreachable
  }
  llvm.func @_Z4funcv()
}

// CHECK:      [MLInlineAdvisor] FuncLevels:
// CHECK-NEXT: _Z5get_sv : 1
// CHECK-NEXT: _ZN1S12promise_typeD2Ev : 0
// CHECK-NEXT: _Z5get_sv.resume : 1
// CHECK-NEXT: _Z5get_sv.destroy : 1
// CHECK-NEXT: _Z5get_sv.cleanup : 1
